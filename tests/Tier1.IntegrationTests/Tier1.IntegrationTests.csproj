<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <!-- Descriptive test names with underscores; the naming and ConfigureAwait rules do not apply to a test project. -->
    <NoWarn>$(NoWarn);CA1707;CA2007;CA1861;CA5394;CA1307;CA1309;CA1515;CA2234</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.13" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.0" />
    <PackageReference Include="Testcontainers.MongoDb" Version="4.16.0" />
    <PackageReference Include="Testcontainers.PostgreSql" Version="4.16.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Tier1.Api\Tier1.Api.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- The same call helpers as the E2E suite (Scenario, Calls), so both suites read alike. -->
    <Compile Include="..\Tier1.E2E\E2E.cs" Link="Shared\E2E.cs" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="Tier1.Api.Startup.DemoData" />
    <Using Include="Tier1.E2E" />
    <Using Include="System.Text.Json.Nodes" />
  </ItemGroup>
</Project>
