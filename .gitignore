# .NET
bin/
obj/
*.user
TestResults/

# Node
node_modules/
dist/
*.tsbuildinfo

# Python
__pycache__/
*.pyc

# Office temp files
~$*.xlsx

# Secrets and runtime data (dev-only values are committed in appsettings.Development.json)
.env
data/
