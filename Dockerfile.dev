# syntax=docker/dockerfile:1

# Development container.
#   The repository is bind-mounted at /work/repo (see docker-compose.dev.yml) and
#   `dotnet watch` rebuilds and restarts on every saved file, so the image is never
#   rebuilt for a code change. Rebuild it only when THIS file changes.
#   (The production image is deploy/Dockerfile.)
FROM mcr.microsoft.com/dotnet/sdk:10.0
# Time-zone data: deadlines are in Cairo time.
RUN apt-get update && apt-get install -y --no-install-recommends tzdata && rm -rf /var/lib/apt/lists/*
# ArtifactsPath sends every project's bin/ and obj/ to /work/out (a named volume) instead
# of the host tree, so Linux build outputs never mix with a local Windows `dotnet run`.
ENV ASPNETCORE_ENVIRONMENT=Development \
    DOTNET_CLI_TELEMETRY_OPTOUT=1 \
    DOTNET_NOLOGO=1 \
    ArtifactsPath=/work/out \
    DefaultItemExcludes="bin/**;obj/**" \
    # Inotify events do not cross a Docker Desktop bind mount (Windows/macOS);
    # polling works everywhere. Linux hosts may set it to 0 in the compose file.
    DOTNET_USE_POLLING_FILE_WATCHER=1
WORKDIR /work/repo
EXPOSE 5150
# --no-hot-reload: rebuild + restart on every save; hot reload can crash the watcher on EF query edits.
CMD ["dotnet", "watch", "run", "--project", "src/Tier1.Api", "--non-interactive", "--no-launch-profile", "--no-hot-reload"]
