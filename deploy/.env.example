# انسخ هذا الملف إلى deploy/.env واملأه على الخادم فقط. لا يدخل المستودع.
# كلمات المرور: 24 حرفًا عشوائيًا على الأقل لكل منها (scripts/new-secrets.ps1 يولدها).

# اسم الخادم كما يكتبه المستخدمون، وشهادته في TLS_CERT_DIR باسمي tier1.crt وtier1.key.
TIER1_HOST=tier1.capu.edu.eg
TLS_CERT_DIR=/etc/tier1/certs

POSTGRES_PASSWORD=
MONGO_ROOT_PASSWORD=
MONGO_APP_PASSWORD=
MONGO_READER_PASSWORD=

# مفتاح بصمة سلسلة السجلات: 32 بايت Base64، يحفظ خارج القاعدتين (نسخة في خزنة الجامعة).
T1_CHAIN_KEY=
# مفتاح بصمة الرقم القومي: 32 بايت Base64، يحفظ خارج القاعدة (نسخة في خزنة الجامعة). لا يغيَّر بعد أول حساب: تغييره يبطل منع تكرار الرقم.
T1_PERSONAL_DATA_KEY=
# بريد يستقبل نقاط تثبيت السجلات خارج المنظومة (المراجعة الداخلية مثلًا).
CHECKPOINT_EMAIL=

# شهادة PFX تشفر مفاتيح حماية البيانات (أسرار التحقق بخطوتين) على القرص.
DP_CERT_FILE=/etc/tier1/dp.pfx
DP_CERT_PASSWORD=

# خادم البريد المؤسسي للإشعارات والتذكيرات.
SMTP_HOST=smtp.capu.edu.eg
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=tier1@capu.edu.eg
