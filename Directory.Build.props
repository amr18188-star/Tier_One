<Project>
  <!-- إعدادات موحدة لكل مشاريع .NET في منظومة مركز اللغات -->
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AnalysisLevel>latest</AnalysisLevel>
    <!-- قواعد الأمان كلها في محلل .NET (حقن SQL، XSS، التشفير الضعيف، فك التسلسل غير الآمن…) -->
    <AnalysisModeSecurity>All</AnalysisModeSecurity>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <InvariantGlobalization>false</InvariantGlobalization>
    <!--
      Build output outside the project folders: artifacts/bin and artifacts/obj at the repository root. The dev containers
      bind-mount this tree and run `dotnet watch` with a polling watcher over the project folders; a local build rewriting
      src/*/bin under it crashed the watcher ("An item with the same key has already been added"). The containers set
      ArtifactsPath=/work/out themselves, which wins over this default.
    -->
    <ArtifactsPath Condition="'$(ArtifactsPath)' == ''">$(MSBuildThisFileDirectory)artifacts</ArtifactsPath>
  </PropertyGroup>
</Project>
