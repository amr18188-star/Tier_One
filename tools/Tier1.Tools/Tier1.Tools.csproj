<Project Sdk="Microsoft.NET.Sdk">
  <!--
    ARCH-4: the maintenance, import and demo-data commands, apart from the production API (which keeps only migrate and
    create-superadmin). Same configuration as the API: its appsettings files, the same user secrets in Development, then
    environment variables. Usage: Program.cs, or run the tool without arguments.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Tier1.Tools</RootNamespace>
    <UserSecretsId>tier1-capu-dev</UserSecretsId>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Tier1.Infrastructure\Tier1.Infrastructure.csproj" />
    <ProjectReference Include="..\..\tests\Tier1.TestSupport\Tier1.TestSupport.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- The API's own settings, so a command reads exactly what the server reads. -->
    <Content Include="..\..\src\Tier1.Api\appsettings.json" Link="appsettings.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\src\Tier1.Api\appsettings.Development.json" Link="appsettings.Development.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Never" Condition="Exists('..\..\src\Tier1.Api\appsettings.Development.json')" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Tier1.Tests" />
  </ItemGroup>
</Project>
